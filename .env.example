# Copy to .env on the VM (never commit .env). The key is read from the environment only; it is never logged or returned.
# Vultr Serverless Inference is OpenAI-compatible. List the models your key can use:
#   curl -s https://api.vultrinference.com/v1/models -H "Authorization: Bearer $LLM_API_KEY"
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
LLM_MODEL=
# Any other OpenAI-compatible endpoint works for local testing, e.g.
#   LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# Set LLM_DISABLED=1 to run with code-written text only (numbers are identical either way).
